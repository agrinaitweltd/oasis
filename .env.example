# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service-role key (Settings -> API -> service_role). Server-only, never
# exposed to the browser. Used by app/api/auth/* to create/confirm users
# and reset passwords without relying on Supabase's own email/OTP system.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (resend.com/api-keys) - all account emails (verification, password
# reset, welcome) are sent directly from Next.js API routes via Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=OASIS <noreply@oasis.co.ug>

# Base URL used to build email verification / password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
