# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Resend (resend.com/api-keys) - used for password reset / email verification /
# welcome emails via the Supabase Auth "send email" hook (see supabase/functions/send-email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=OASIS <noreply@oasis.co.ug>

# Base URL used to build email confirmation / reset-password links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
