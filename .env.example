# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Signup, email verification, and password reset all go through the shared
# send-otp / create-account / reset-password-otp Edge Functions (same OTP
# system the mobile app uses), called client-side with the anon key above.

# Service-role key (Settings -> API -> service_role). Server-only, used only
# by app/api/admin/create-user - lets a super_admin provision a login for a
# specific school/role without the OTP round trip. Never exposed to the
# browser. Not needed for anything else in this app.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
